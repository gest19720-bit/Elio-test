{
  "builds": [
    { "src": "oauth-authorization-server.js", "use": "@vercel/node" },
    { "src": "oauth-protected-resource.js", "use": "@vercel/node" },
    { "src": "oauth-authorize.js", "use": "@vercel/node" },
    { "src": "oauth-token.js", "use": "@vercel/node" },
    { "src": "oauth-register.js", "use": "@vercel/node" },
    { "src": "oauth-request-details.js", "use": "@vercel/node" },
    { "src": "mcp-api.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/.well-known/oauth-protected-resource", "dest": "/oauth-protected-resource.js" },
    { "src": "/.well-known/oauth-authorization-server", "dest": "/oauth-authorization-server.js" },
    { "src": "/oauth/authorize", "dest": "/oauth-authorize.js" },
    { "src": "/oauth/token", "dest": "/oauth-token.js" },
    { "src": "/oauth/register", "dest": "/oauth-register.js" },
    { "src": "/api/oauth/request-details", "dest": "/oauth-request-details.js" },
    { "src": "/mcp", "dest": "/mcp-api.js" },
    { "handle": "filesystem" }
  ]
}
